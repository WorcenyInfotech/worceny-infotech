# MongoDB connection string (Atlas or local)
# Example local: mongodb://127.0.0.1:27017/worceny
# Example Atlas: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/worceny?retryWrites=true&w=majority
MONGODB_URI=

# Resend API (contact form email)
RESEND_API_KEY=

# Inbox that receives contact form notifications
ADMIN_EMAIL=

# Cloudinary keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
